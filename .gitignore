# Dependencies
node_modules/

# Environment and Config
.env*
*.env
.env-prod
.ngrok.yml

# Data files (critical)
playerData.json
safariContent.json

# Rolling backups
*.json.backup
*.json.REJECTED
*.json.bak
backups/

# Runtime state
scheduledJobs.json
dstState.json
restartHistory.json
messageHistory.json
entitlements.json

# Other data
img/tips/tips.json
img/*/map_*.png
img/*/map_*.jpg
img/*/temp_*.png
img/*/*.png
img/*/*.jpg
# Guide infographics ARE committed assets (embedded via guideAssets.js) — carve them out
# of the img/*/*.png sweep above. Their CDN-URL cache and emoji cache stay untracked.
!img/guides/*.png
img/guides/guides.json
img/guides/.emoji-cache/
data_*.json

# System files
desktop.ini
.DS_Store
Thumbs.db
*.Zone.Identifier

# Logs and temp
logs/
*.log
.archive/
.supporting/

# SSH keys
castbot-key.pem
*.pem

# VS Code shit
.vscode/settings.json
.vscode/settings.local.json

# Secrets
.env.local
challengeLibrary.json

# Runtime-generated map overlays (the box's bot writes these; tracked temp/ overlays are .png assets)
temp/map_overlay_*.jpg

# Safari export/import deliverables (bot-generated, or downloaded into temp/ for debugging)
temp/safari-package-*.zip
temp/safari-export-*.json
temp/safari-import-*.json

# RaP numbering is derived from filenames, not a tracked counter (it collided across two working trees — RaP 0913)
docs/01-RaP/.counter

# Host-supplied spreadsheets — real applicant PII (emails, phones, emergency contacts, medical)
temp/*.xlsx
temp/*.csv

# Generated release-card images (rebuild from scripts/release/releases/ specs)
temp/castbot-update-*.png

# Discord status watchdog state (Tier 3 - ephemeral, test box only)
discordStatusState.json
